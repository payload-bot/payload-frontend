---
const { frontmatter } = Astro.props;
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title={frontmatter.title}>
  <main class="prose mx-auto mt-6 min-h-screen max-w-xs pb-10 dark:prose-invert sm:max-w-sm md:max-w-lg lg:max-w-xl xl:max-w-4xl">
    <slot />
  </main>

    <Footer />
</Layout>

